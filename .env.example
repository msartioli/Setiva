# Copie para .env.local e preencha com os valores do seu projeto Supabase.
# Nunca commitar .env.local (ja esta no .gitignore via .env*).

# Painel do Supabase > Project Settings > API. Publishable key e destinada
# ao cliente; a protecao real dos dados depende do RLS nas migrations.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# URL publica do app (usada em links de confirmacao/recuperacao de senha).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Somente em ambiente de servidor (nunca prefixo NEXT_PUBLIC_, nunca no
# navegador). Necessaria apenas para a exclusao de conta
# (src/actions/account.ts -> src/lib/supabase/admin.ts). Painel do Supabase
# > Project Settings > API > service_role.
SUPABASE_SERVICE_ROLE_KEY=

# Opcionais: so preencha se quiser apontar para um espelho/proxy proprio
# das APIs publicas. Sem chave — sao APIs gratuitas e sem autenticacao.
# Ver docs/integrations/financial-data.md.
BRASIL_API_BASE_URL=
BCB_API_BASE_URL=
